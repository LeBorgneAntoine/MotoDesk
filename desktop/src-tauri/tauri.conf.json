{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motodesk",
  "version": "0.1.0",
  "identifier": "com.motodesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Motodesk",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic"]
        },
        "center": true,
        "fullscreen": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* http://127.0.0.1:17300 http://127.0.0.1:8080 https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Motodesk",
    "shortDescription": "Gestion des ateliers et concessions moto et cycle : atelier, stock, caisse et comptabilité fiscale",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
